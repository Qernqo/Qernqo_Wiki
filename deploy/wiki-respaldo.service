# /etc/systemd/system/wiki-respaldo.service
[Unit]
Description=Respaldo incremental de la Wiki Unidad Soporte TI (restic)

[Service]
Type=oneshot
User=wiki
Group=wiki
EnvironmentFile=/etc/wiki/wiki.env
Environment=RESTIC_REPOSITORY=/var/backups/wiki-restic
Environment=RESTIC_PASSWORD_FILE=/etc/wiki/restic.pass
# caché de restic en /var/cache/wiki-restic (la crea systemd)
CacheDirectory=wiki-restic
Environment=RESTIC_CACHE_DIR=/var/cache/wiki-restic
Nice=10
IOSchedulingClass=idle
ExecStart=/srv/wiki/app/deploy/respaldo.sh

# endurecimiento: lee los datos, solo escribe en el repositorio de respaldo
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/backups/wiki-restic
