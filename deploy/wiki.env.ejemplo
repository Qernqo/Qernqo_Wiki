# /etc/wiki/wiki.env — variables del servicio
WIKI_PORT=3000
WIKI_HOST=127.0.0.1
WIKI_DATA_DIR=/srv/wiki/data
# Caddy sirve los estáticos en producción
WIKI_SERVIR_ESTATICOS=0
# 1 = cookie de sesión solo por HTTPS (Cloudflare siempre entrega HTTPS)
WIKI_COOKIE_SECURE=1
# Cloudflare admite hasta 100 MB por petición
WIKI_MAX_BODY_MB=95
