# /etc/caddy/Caddyfile — configuración base de todos los sitios del servidor.
# Cada subdominio vive en su propio archivo: /etc/caddy/sitios/<sitio>.caddy
#
#   Cloudflare (túnel + Access) ─► cloudflared ─► Caddy 127.0.0.1:80 ─► sitio según el dominio
{
	# El HTTPS lo pone Cloudflare: Caddy atiende solo HTTP local.
	auto_https off
	# Solo accesible desde la propia máquina (cloudflared se conecta a localhost:80).
	# Para entrar también desde la red interna agrega la IP privada: default_bind 127.0.0.1 10.0.0.5
	default_bind 127.0.0.1
}

# Ajustes comunes a todos los sitios: compresión, cabeceras de seguridad
# y bloqueo de archivos ocultos (.git, .env, temporales…).
(comunes) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy same-origin
		-Server
	}
	@oculto path_regexp oculto /\.
	handle @oculto {
		respond 404
	}
}

# Sitio de HTML estático. Uso: import estatico /srv/<sitio>/public
(estatico) {
	import comunes
	handle {
		root * {args[0]}
		# revalidar siempre: al actualizar el sitio los navegadores toman los cambios
		header Cache-Control "no-cache"
		file_server
	}
}

import sitios/*.caddy

# Cualquier otro dominio que llegue por el túnel.
http:// {
	respond "Sitio no configurado" 404
}
