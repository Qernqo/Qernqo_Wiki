# Copiar como .env (junto a docker-compose.yml) y completar:
#   cp .env.ejemplo .env && chmod 600 .env

# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels → el túnel → token).
TUNNEL_TOKEN=

# Carpeta de datos en el servidor (biblioteca, papelera, claves). Debe pertenecer al uid 1000.
WIKI_DATOS=/srv/wiki/data
